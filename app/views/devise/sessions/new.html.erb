<% content_for :title, "Вход — PERPET" %>

<main class="main">
  <section class="reg reg--login">
    <%= image_tag "hero-19.svg", alt: "", class: "reg__hand" %>
    <%= image_tag "tb-logo-ear.svg", alt: "", class: "reg__rabbit" %>
    <span class="reg__eye reg__eye--left"></span>
    <span class="reg__eye reg__eye--right"></span>

    <div class="reg__body">
      <h1 class="reg__title">Вход</h1>

      <%= form_with model: resource, as: resource_name, url: session_path(resource_name), class: "reg__form" do |f| %>
        <%= f.text_field :login, autofocus: true, autocomplete: "username", class: "reg__field",
                         placeholder: "Логин*", required: true, "aria-label": "Логин" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "reg__field",
                             placeholder: "Пароль*", required: true, "aria-label": "Пароль" %>

        <% if devise_mapping.rememberable? %>
          <label class="reg__remember">
            <%= f.check_box :remember_me %>
            <span>Запомнить меня</span>
          </label>
        <% end %>

        <div class="reg__actions">
          <button class="reg__arrow" type="submit" title="Вход" aria-label="Вход">
            <%= image_tag "shape-11.svg", alt: "" %>
          </button>
          <%= f.submit "Вход", class: "reg__submit" %>
        </div>
      <% end %>
    </div>
  </section>

  <section class="reg__switch">
    <p class="reg__switch-text">Еще нет аккаунта?</p>
    <div class="reg__actions">
      <%= link_to new_user_registration_path, class: "reg__arrow", title: "Присоединиться" do %>
        <%= image_tag "shape-11.svg", alt: "" %>
      <% end %>
      <%= link_to "Присоединиться", new_user_registration_path, class: "reg__switch-btn" %>
    </div>
  </section>

  <div class="reg__aside">
    <%= render "shared/vk_button", label: "Войти через ВКонтакте" %>
    <%= render "devise/shared/links" %>
  </div>
</main>
