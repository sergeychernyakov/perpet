<% content_for :title, "Вход — PERPET" %>

<main class="main auth">
  <div class="auth__card">
    <h1 class="auth__title">Вход</h1>
    <p class="auth__lead">Войдите, чтобы вести профиль питомца и свои объявления.</p>

    <%= form_with model: resource, as: resource_name, url: session_path(resource_name), class: "form" do |f| %>
      <label class="auth__field">
        <span class="form__label">E-mail</span>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form__input", placeholder: "you@mail.ru", required: true %>
      </label>

      <label class="auth__field">
        <span class="form__label">Пароль</span>
        <%= f.password_field :password, autocomplete: "current-password", class: "form__input", placeholder: "••••••", required: true %>
      </label>

      <% if devise_mapping.rememberable? %>
        <label class="auth__remember">
          <%= f.check_box :remember_me %>
          <span>Запомнить меня</span>
        </label>
      <% end %>

      <div class="auth__actions">
        <%= f.submit "Войти", class: "btn btn--wine btn--wide" %>
      </div>
    <% end %>

    <%= render "shared/vk_button", label: "Войти через ВКонтакте" %>

    <%= render "devise/shared/links" %>
  </div>
</main>
