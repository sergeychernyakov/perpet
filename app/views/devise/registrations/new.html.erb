<% content_for :title, "Регистрация — PERPET" %>

<main class="main">
  <section class="reg">
    <%= image_tag "tb-logo-ear.svg", alt: "", class: "reg__hand" %>
    <%= image_tag "tb-profile-hand.svg", alt: "", class: "reg__rabbit" %>
    <span class="reg__eye reg__eye--left"></span>
    <span class="reg__eye reg__eye--right"></span>

    <div class="reg__body">
      <h1 class="reg__title">Регистрация</h1>

      <%= form_with model: resource, as: resource_name, url: registration_path(resource_name), class: "reg__form" do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "reg__field",
                          placeholder: "E-mail", required: true, "aria-label": "E-mail" %>
        <%= f.password_field :password, autocomplete: "new-password", class: "reg__field",
                             placeholder: "Пароль",
                             required: true, minlength: @minimum_password_length, "aria-label": "Пароль" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "reg__field",
                             placeholder: "Пароль ещё раз", required: true, "aria-label": "Пароль ещё раз" %>

        <button type="submit" class="reg__submit" title="Зарегистрироваться">
          <%= image_tag "shape-11.svg", alt: "Зарегистрироваться" %>
        </button>
      <% end %>

    </div>
  </section>

  <div class="reg__aside">
    <%= render "shared/vk_button", label: "Продолжить через ВКонтакте" %>
    <%= render "devise/shared/links" %>
  </div>
</main>
