<% content_for :title, "Регистрация — PERPET" %>

<main class="main">
  <section class="reg">
    <%= image_tag "hero-19.svg", alt: "", class: "reg__hand" %>
    <%= image_tag "tb-logo-ear.svg", alt: "", class: "reg__rabbit" %>
    <span class="reg__eye reg__eye--left"></span>
    <span class="reg__eye reg__eye--right"></span>

    <div class="reg__body">
      <h1 class="reg__title">Регистрация</h1>

      <%= form_with model: resource, as: resource_name, url: registration_path(resource_name), class: "reg__form" do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <%= f.text_field :name, autofocus: true, class: "reg__field",
                         placeholder: "Имя*", required: true, "aria-label": "Имя" %>
        <%= f.email_field :email, autocomplete: "email", class: "reg__field",
                          placeholder: "Почта*", required: true, "aria-label": "Почта" %>
        <%= f.text_field :login, autocomplete: "username", class: "reg__field",
                         placeholder: "Логин*", required: true, "aria-label": "Логин" %>
        <%= f.password_field :password, autocomplete: "new-password", class: "reg__field",
                             placeholder: "Пароль*", required: true,
                             minlength: @minimum_password_length, "aria-label": "Пароль" %>

        <%= f.submit "Присоединиться", class: "reg__submit" %>
      <% end %>
    </div>
  </section>

  <section class="reg__switch">
    <p class="reg__switch-text">Уже есть аккаунт?</p>
    <%= link_to "Вход", new_user_session_path, class: "reg__switch-btn" %>
  </section>

  <div class="reg__aside">
    <%= render "shared/vk_button", label: "Продолжить через ВКонтакте" %>
    <%= render "devise/shared/links" %>
  </div>
</main>
