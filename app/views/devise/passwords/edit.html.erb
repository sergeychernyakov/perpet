<% content_for :title, "Новый пароль — PERPET" %>

<main class="main auth">
  <div class="auth__card">
    <h1 class="auth__title">Новый пароль</h1>

    <%= form_with model: resource, as: resource_name, url: password_path(resource_name), method: :put, class: "form" do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <label class="auth__field">
        <span class="form__label">Пароль</span>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form__input",
                             placeholder: "минимум #{@minimum_password_length} символов",
                             required: true, minlength: @minimum_password_length %>
      </label>

      <label class="auth__field">
        <span class="form__label">Пароль ещё раз</span>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form__input", required: true %>
      </label>

      <div class="auth__actions">
        <%= f.submit "Сохранить пароль", class: "btn btn--coral btn--wide" %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</main>
