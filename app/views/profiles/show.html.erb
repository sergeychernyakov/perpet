<% content_for :title, "Ваш профиль — PERPET" %>

<main class="main">
  <section class="banner">
    <h1 class="banner__title">Ваш профиль</h1>
  </section>

  <div class="person">
    <div class="person__photo">
      <% if @profile.photo.attached? %>
        <%= image_tag @profile.photo_url, alt: @profile.name %>
      <% else %>
        <%= image_tag "ab-paw-cream.svg", alt: "", class: "person__photo-icon" %>
      <% end %>
    </div>

    <article class="person__card">
      <h2 class="person__subtitle">Информация о пользователе</h2>
      <p class="person__lines">
        <% if @profile.card_lines.any? %>
          <% @profile.card_lines.each do |line| %>
            <span><%= line %></span>
          <% end %>
        <% else %>
          <span>Расскажите о себе — так вас узнают другие пользователи.</span>
        <% end %>
      </p>
      <%= link_to "Изменить данные", edit_profile_path, class: "person__edit" %>
    </article>

    <div class="person__side">
      <article class="person__card person__card--short">
        <h2 class="person__subtitle">Контакты</h2>
        <p class="person__lines">
          <% if @profile.contact_lines.any? %>
            <% @profile.contact_lines.each do |line| %>
              <span><%= line %></span>
            <% end %>
          <% else %>
            <span>Телефон и почту видят те, кто откликается на карточку.</span>
          <% end %>
        </p>
      </article>

      <%= link_to profile_pets_path, class: "person__card person__card--back" do %>
        <span class="person__subtitle">Ваши питомцы</span>
        <span class="person__arrow"><%= image_tag "shape-11.svg", alt: "" %></span>
      <% end %>
    </div>
  </div>

  <div class="profile__cards">
    <%= link_to new_ad_path(role: Ad::SITTER), class: "profile__add" do %>
      <span class="profile__add-title">Добавь карточку ситтера</span>
      <span class="person__arrow"><%= image_tag "shape-11.svg", alt: "" %></span>
      <%= image_tag "tb-logo-ear.svg", alt: "", class: "profile__add-paw" %>
    <% end %>

    <%= link_to new_ad_path(role: Ad::PET), class: "profile__add" do %>
      <span class="profile__add-title">Добавь карточку питомца</span>
      <span class="person__arrow"><%= image_tag "shape-11.svg", alt: "" %></span>
      <%= image_tag "ab-paw-cream.svg", alt: "", class: "profile__add-paw" %>
    <% end %>

    <p class="profile__note">
      После заполнения профиля добавляйте карточки хозяина или питомца,
      чтобы продолжать поддерживать питомцев и их хозяев.
    </p>
  </div>

  <div class="profile__account">
    <span><%= current_user.email %></span>
    <% if current_user.vk_id.present? %>
      <span class="profile__vk">ВКонтакте привязан</span>
    <% else %>
      <%= render "shared/vk_button", label: "Привязать ВКонтакте" %>
    <% end %>
    <%= link_to "Аккаунт", edit_user_registration_path, class: "btn" %>
    <% if current_user.admin? %>
      <%= link_to "Админка", admin_root_path, class: "btn" %>
    <% end %>
    <%= button_to "Выйти", destroy_user_session_path, method: :delete, class: "btn", form_class: "contents" %>
  </div>
</main>
