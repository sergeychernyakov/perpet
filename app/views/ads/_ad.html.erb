<article class="ad">
  <%# Есть фотография — показываем её, нет — силуэт из макета. %>
  <div class="ad__cover">
    <% if ad.photo.attached? %>
      <%= image_tag ad.photo_url, alt: ad.title, class: "ad__photo", loading: "lazy" %>
    <% else %>
      <%= image_tag ad.icon_name, alt: "" %>
    <% end %>
    <span class="ad__kind"><%= ad.kind %></span>
  </div>

  <div class="ad__body">
    <h3 class="ad__title"><%= ad.title %></h3>
    <p class="ad__meta"><%= ad.meta %></p>
    <p class="ad__text"><%= ad.description %></p>

    <div class="ad__footer">
      <span class="ad__price"><%= ad.price %></span>
      <%= modal_button "Откликнуться", kind: "respond", subject: ad.title, css: "btn btn--coral" %>
    </div>
  </div>
</article>
