<% content_for :title, "#{@article.title} — PERPET" %>
<% content_for :description, @article.excerpt %>

<main class="main">
  <section class="banner">
    <h1 class="banner__title"><%= @article.title %></h1>
  </section>

  <article class="reading">
    <% @article.layout.each do |row| %>
      <% case row[:kind] %>
      <% when "section" %>
        <section class="banner"><h2 class="banner__title"><%= row[:text] %></h2></section>
      <% when "highlight" %>
        <p class="reading__highlight"><%= row[:text] %></p>
      <% when "row" %>
        <%= render "articles/row", row: row %>
      <% else %>
        <%= render "articles/block", block: row %>
      <% end %>
    <% end %>

    <div class="reading__actions">
      <%= link_to "Все статьи", articles_path, class: "btn" %>
      <%= modal_button "Присоединиться", css: "btn btn--coral btn--wide" %>
    </div>
  </article>

  <% if @more.any? %>
    <section class="banner">
      <h2 class="banner__title">Читать дальше</h2>
    </section>

    <div class="articles">
      <% @more.each_with_index do |article, index| %>
        <%= render "articles/article", article: article, article_index: index %>
      <% end %>
    </div>
  <% end %>
</main>
