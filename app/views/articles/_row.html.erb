<%# Ряд из макета. Колонка с заголовком — панель сбоку (если она одна)
    или панель сверху (если колонок несколько). Колонки без заголовка —
    просто плашки в ряд. %>
<% columns = row[:columns] %>
<% titled = columns.any? { |column| column[:title].present? } %>
<% tone = columns.first[:tone] %>

<% if titled && columns.size == 1 %>
  <div class="reading__row reading__row--split reading__row--<%= tone %>">
    <h3 class="reading__panel reading__panel--<%= tone %>"><%= columns.first[:title] %></h3>

    <div class="reading__col">
      <% columns.first[:blocks].each do |block| %>
        <%= render "articles/block", block: block %>
      <% end %>
    </div>
  </div>
<% else %>
  <%# Внутри ряда цвет панелей один — иначе колонки спорят друг с другом. %>
  <div class="reading__row" style="--cols: <%= columns.size %>;">
    <% columns.each do |column| %>
      <div class="reading__column">
        <% if column[:title].present? %>
          <h3 class="reading__panel reading__panel--<%= tone %>"><%= column[:title] %></h3>
        <% end %>

        <div class="reading__col">
          <% column[:blocks].each do |block| %>
            <%= render "articles/block", block: block %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
