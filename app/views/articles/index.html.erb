<% content_for :title, "Статьи — PERPET" %>

<main class="main">
  <section class="articles__head">
    <h1 class="articles__title">Статьи</h1>
  </section>

  <div class="articles" id="arts-top">
    <% @articles.each_with_index do |article, index| %>
      <%= render "articles/article", article: article, article_index: index %>
    <% end %>
  </div>

  <%= render "shared/pager", pager: @pager, anchor: "arts-top" %>
</main>
