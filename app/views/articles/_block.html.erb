<%# Внутри плашки с заливкой и рамки колонки текст идёт без своей рамки.
    paw — рука сбоку у пунктов, badge — кружок со стрелкой в чек-листе. %>
<% bare = local_assigns.fetch(:bare, false) %>
<% paw = local_assigns[:paw] %>
<% badge = local_assigns.fetch(:badge, false) %>
<% art = block[:art] %>

<% if block[:kind] == "list" %>
  <div class="reading__pills">
    <% block[:items].each do |item| %>
      <p class="reading__pill <%= "reading__pill--paw reading__pill--paw-#{paw[:side]}" if paw %>">
        <% if paw %>
          <%= image_tag paw[:tone] == "coral" ? "hero-19.svg" : "paw-lime.svg", alt: "", class: "reading__pill-paw" %>
          <%= image_tag "tb-logo-ear.svg", alt: "", class: "reading__pill-ear" %>
        <% end %>
        <span><%= item %></span>
        <% if badge %>
          <span class="reading__pill-badge"><%= image_tag "shape-11.svg", alt: "" %></span>
        <% end %>
      </p>
    <% end %>
  </div>
<% elsif bare %>
  <p class="reading__text"><%= block[:text] %></p>
<% else %>
  <p class="reading__plate <%= "reading__plate--lime" if block[:tone] == "lime" %>
            <%= "reading__plate--#{art}" if art %>">
    <%= article_art(art) %>
    <span><%= block[:text] %></span>
  </p>
<% end %>
