<%= form_with model: [ :admin, item ], class: "admin__form" do |f| %>
  <% if item.errors.any? %>
    <div class="errors"><ul><% item.error_messages.each do |m| %><li><%= m %></li><% end %></ul></div>
  <% end %>

  <label>
    <span class="form__label">Заголовок</span>
    <%= f.text_field :title, class: "form__input", required: true %>
  </label>

  <label>
    <span class="form__label">Тег</span>
    <%= f.text_field :tag, class: "form__input" %>
  </label>

  <label>
    <span class="form__label">Время чтения</span>
    <%= f.text_field :read_time, class: "form__input" %>
  </label>

  <label>
    <span class="form__label">Короткое описание</span>
    <%= f.text_area :excerpt, class: "form__textarea", rows: 3 %>
  </label>

  <label>
    <span class="form__label">Текст статьи</span>
    <%= f.text_area :body, class: "form__textarea", rows: 10 %>
  </label>

  <label>
    <span class="form__label">Порядок</span>
    <%= f.number_field :position, class: "form__input" %>
  </label>


  <div class="auth__actions">
    <%= f.submit "Сохранить", class: "btn btn--coral" %>
    <%= link_to "Отмена", admin_articles_path, class: "btn" %>
  </div>
<% end %>
