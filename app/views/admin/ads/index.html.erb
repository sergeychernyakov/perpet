<% content_for :title, "Объявления — админка" %>

<main class="main admin">
  <section class="admin__head">
    <h1>Объявления</h1>
    <%= render "admin/nav" %>
  </section>

  <section class="admin__panel">
    <p><%= link_to "Новое объявление", new_admin_ad_path, class: "btn btn--wine" %></p>

    <table class="admin__table">
      <thead>
        <tr><th>Название</th><th>Вид</th><th>Город</th><th>Цена</th><th>Статус</th><th>Владелец</th><th></th></tr>
      </thead>
      <tbody>
        <% @ads.each do |ad| %>
          <tr>
            <td><%= ad.title %></td>
            <td><%= ad.kind %></td>
            <td><%= ad.city %></td>
            <td><%= ad.price %></td>
            <td><%= ad.status_label %></td>
            <td><%= ad.profile&.name || "—" %></td>
            <td class="admin__actions">
              <%= link_to "Изменить", edit_admin_ad_path(ad), class: "btn" %>
              <%= button_to "Удалить", admin_ad_path(ad), method: :delete, class: "btn", form_class: "contents",
                            data: { turbo_confirm: "Удалить объявление?" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
</main>
