<!DOCTYPE html>
<html lang="ru">
  <head>
    <title><%= content_for(:title) || "PERPET — передержка питомцев" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for(:description) || "PERPET — сервис передержки животных: объявления, статьи и поддержка 24/7." %>">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="PERPET">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anonymous+Pro:wght@400;700&family=Arsenal+SC:wght@400;700&family=Comfortaa:wght@300..700&family=Comic+Relief&family=Inter:wght@100..900&display=swap">

    <%= stylesheet_link_tag "vars", "base", "layout", "components",
                            "pages/home", "pages/ads", "pages/articles",
                            "pages/about", "pages/profile", "pages/support",
                            "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="page" data-controller="menu modal">
      <%= render "shared/header" %>
      <%= render "shared/menu" %>

      <% if flash[:notice] %>
        <p class="flash"><%= flash[:notice] %></p>
      <% end %>

      <%= yield %>

      <%= render "shared/footer" %>
      <%= render "shared/modal" %>
    </div>
  </body>
</html>
