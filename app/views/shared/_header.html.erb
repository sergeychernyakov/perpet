<header class="header">
  <%= link_to root_path, class: "logo", title: "На главную" do %>
    <%= image_tag "tb-logo-hand.svg", alt: "", class: "logo__shape" %>
    <%= image_tag "tb-logo-ear.svg", alt: "", class: "logo__ear" %>
    <span class="logo__eye logo__eye--left"></span>
    <span class="logo__eye logo__eye--right"></span>
    <span class="logo__name">PERPET</span>
  <% end %>

  <nav class="nav">
    <%= nav_link "Статьи", articles_path %>
    <%= nav_link "Обьявления", ads_path %>
    <%= nav_link "О нас", about_path %>
    <%= nav_link "Поддержка", support_path %>
    <% if current_user&.admin? %>
      <%= nav_link "Админка", admin_root_path %>
    <% end %>
  </nav>

  <button class="burger" type="button" title="Меню" aria-label="Меню" data-action="menu#toggle">
    <span></span>
    <span></span>
    <span></span>
  </button>

  <%# Гостю кнопка ведёт на вход, а не на профиль, откуда его всё равно развернёт. %>
  <% signed_in = user_signed_in? %>
  <%= link_to (signed_in ? profile_path : new_user_session_path),
              class: "icon-btn", title: (signed_in ? "Профиль" : "Войти") do %>
    <%= image_tag "tb-profile-hand.svg", alt: "", class: "icon-btn__shape" %>
    <span class="icon-btn__eye icon-btn__eye--left"></span>
    <span class="icon-btn__eye icon-btn__eye--right"></span>
  <% end %>
</header>
