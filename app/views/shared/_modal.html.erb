<div class="modal" id="modal" hidden
     data-menu-target="modalRoot"
     data-modal-target="dialog"
     data-action="click->modal#backdrop keydown.esc->modal#close">
  <div class="modal__dialog" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <button class="modal__close" type="button" title="Закрыть" aria-label="Закрыть" data-action="modal#close">✕</button>

    <div id="modal-body">
      <%= render "shared/modal_form", lead: Lead.new(kind: "join") %>
    </div>
  </div>
</div>
